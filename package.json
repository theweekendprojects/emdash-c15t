{
  "name": "emdash-c15t",
  "version": "0.3.0",
  "description": "Per-site GDPR/TDDDG cookie consent for EmDash CMS: a themed, dark/light consent banner (DE/EN) that follows your site's design, with Google Consent Mode v2 and GPC, powered by c15t. Consent proof is stored in your own D1, no third-party backend.",
  "type": "module",
  "license": "MIT",
  "author": "The Weekend Projects",
  "keywords": [
    "emdash",
    "emdash-plugin",
    "consent",
    "cookie-consent",
    "gdpr",
    "tdddg",
    "privacy",
    "c15t",
    "astro",
    "cloudflare"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theweekendprojects/emdash-c15t.git"
  },
  "homepage": "https://github.com/theweekendprojects/emdash-c15t#readme",
  "bugs": {
    "url": "https://github.com/theweekendprojects/emdash-c15t/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "plugin": {
    "id": "emdash-privacy"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "selfcheck": "bash scripts/selfcheck.sh",
    "prepack": "npm run build:client",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./embed": {
      "import": "./src/components/ConsentEmbed.astro",
      "default": "./src/components/ConsentEmbed.astro"
    }
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md",
    "!src/**/*.selfcheck.ts"
  ],
  "peerDependencies": {
    "emdash": ">=1.2.0"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/react": "7.1.9",
    "@c15t/browser": "3.0.0",
    "@c15t/core": "3.0.0",
    "@c15t/integrations": "3.0.0",
    "@c15t/translations": "3.0.0",
    "@types/node": "22.20.5",
    "astro": "7.4.13",
    "emdash": "1.6.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.56.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
